---
import Layout from '../layouts/Layout.astro';

const phone = "(410) 261-4403";
const city = "Towson";
const niche = "DUI Defense";
const serviceImage = "https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=1200&q=80";
---

<Layout 
	title={{\`\${city.toUpperCase()} MD \${{niche.toUpperCase()} | Locally Owned Maryland DUI Defense Pros\` }
	phone={(410) 261-4403}
	city={Towson}
	niche={DUI Defense}
>
	<!-- 1. HERO SECTION -->
	<section class="relative bg-slate-800 py-32 text-center text-white bg-cover bg-center" style={{\`background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('\$https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=1200&q=80');\` }>
		<div class="container mx-auto px-6">
			<h1 class="text-[50px] md:text-[70px] font-black leading-tight mb-4 uppercase tracking-tighter">{DUI Defense} {Towson} MD</h1>
			<h3 class="text-xl md:text-2xl font-bold mb-10 opacity-90 uppercase tracking-[0.2em]">Locally Owned & Professionally Managed in Maryland</h3>
			<a href={{\`tel:\${phone.replace(/-/g, '')}\` } class="inline-block bg-white text-[#28657c] font-black text-2xl px-12 py-5 border-2 border-white hover:bg-transparent hover:text-white transition-all uppercase tracking-tighter shadow-2xl">
				CALL NOW {(410) 261-4403}
			</a>
		</div>
	</section>

	<!-- 2. TRUST PILLARS -->
	<section class="py-20 bg-white">
		<div class="container mx-auto px-6 grid lg:grid-cols-12 gap-16 items-start">
			<div class="lg:col-span-8">
				<h2 class="text-4xl font-black text-[#28657c] mb-12 uppercase tracking-tighter">3 REASONS TO TRUST OUR {{city.toUpperCase()} {{niche.toUpperCase()} TEAM</h2>
				<div class="space-y-12">
					
					<div class="flex gap-8 items-start">
						<div class="w-20 h-20 flex-shrink-0 bg-[#28657c]/5 rounded-2xl flex items-center justify-center text-4xl shadow-sm">⚖️</div>
						<div>
							<h4 class="text-xl font-black text-[#28657c] mb-3 uppercase tracking-tight">AGGRESSIVE LEGAL AUDIT</h4>
							<p class="text-slate-600 leading-relaxed italic">"A DUI in Maryland is a technical battle. We perform a deep-dive audit of the prosecution's evidence and procedural errors."</p>
						</div>
					</div>
					<div class="flex gap-8 items-start">
						<div class="w-20 h-20 flex-shrink-0 bg-[#28657c]/5 rounded-2xl flex items-center justify-center text-4xl shadow-sm">🛡️</div>
						<div>
							<h4 class="text-xl font-black text-[#28657c] mb-3 uppercase tracking-tight">MVA DEADLINE PROTECTION</h4>
							<p class="text-slate-600 leading-relaxed italic">"You have only 10 days to protect your license. We handle the MVA administrative maze to keep you on the road."</p>
						</div>
					</div>
					<div class="flex gap-8 items-start">
						<div class="w-20 h-20 flex-shrink-0 bg-[#28657c]/5 rounded-2xl flex items-center justify-center text-4xl shadow-sm">🔍</div>
						<div>
							<h4 class="text-xl font-black text-[#28657c] mb-3 uppercase tracking-tight">ABUNDANT CLARITY DEFENSE</h4>
							<p class="text-slate-600 leading-relaxed italic">"Total transparency on your case status. We provide a full digital breakdown of every stop and field test discrepancy."</p>
						</div>
					</div>
				</div>
			</div>

			<div class="lg:col-span-4 sticky top-12">
				<div class="bg-slate-50 border-4 border-[#28657c] p-10 shadow-2xl rounded-sm">
					<h3 class="text-2xl font-black text-center text-[#28657c] uppercase mb-8 tracking-tighter">REQUEST A FREE ESTIMATE</h3>
					<form id="leadForm" class="space-y-5">
						<input type="text" name="name" required placeholder="YOUR NAME" class="w-full border-2 border-slate-200 p-4 font-bold outline-[#28657c] transition-all focus:border-[#28657c] uppercase" />
						<input type="tel" name="phone" required placeholder="PHONE NUMBER" class="w-full border-2 border-slate-200 p-4 font-bold outline-[#28657c] transition-all focus:border-[#28657c] uppercase" />
						<input type="text" name="zip" required placeholder="ZIP CODE (E.G. 21131)" class="w-full border-2 border-slate-200 p-4 font-bold outline-[#28657c] transition-all focus:border-[#28657c] uppercase" />
						<textarea name="service" required placeholder="TELL US WHAT YOU NEED..." class="w-full border-2 border-slate-200 p-4 font-bold h-32 outline-[#28657c] transition-all focus:border-[#28657c] uppercase"></textarea>
						<button type="submit" class="w-full bg-[#28657c] text-white py-5 font-black text-xl uppercase tracking-widest hover:bg-[#1e4e5e] transition-all shadow-xl active:scale-95">GET YOUR QUOTE</button>
					</form>
					<p id="formStatus" class="text-[11px] text-slate-400 mt-6 text-center uppercase font-black tracking-widest">100% SATISFACTION GUARANTEED</p>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script is:inline>
	const form = document.getElementById('leadForm');
	const status = document.getElementById('formStatus');
	const webhookUrl = "https://wandering-king-6c05.empty-math-6c0f.workers.dev";

	form?.addEventListener('submit', async (e) => {{
		e.preventDefault();
		const formData = new FormData(form);
		const data = Object.fromEntries(formData.entries());
		
		data.source = window.location.hostname;
		data.timestamp = new Date().toISOString();

		try {{
			status.textContent = "SENDING REQUEST...";
			const response = await fetch(webhookUrl, {{
				method: 'POST',
				headers: {{ 'Content-Type': 'application/json' },
				body: JSON.stringify(data)
			});

			if (response.ok) {{
				status.textContent = "✅ SUCCESS! WE WILL CALL YOU SHORTLY.";
				form.reset();
			} else {{
				throw new Error();
			}
		} catch (err) {{
			status.textContent = "❌ ERROR SENDING. PLEASE CALL US NOW.";
		}
	});
</script>
