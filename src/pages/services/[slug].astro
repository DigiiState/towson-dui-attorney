const page = contentDb[slug] || contentDb["septic-pumping"];
---

<Layout 
	title={page.title}
	phone={phone}
	city={city}
	niche={niche}
>
	<!-- 1. Hero (Mirroring Irving Structure) -->
	<section class="relative bg-slate-800 py-32 text-center text-white bg-cover bg-center" style={`background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('${page.image}');`}>
		<div class="container mx-auto px-6">
			<h1 class="text-[50px] font-bold leading-tight mb-4 uppercase tracking-tighter">{page.name} {city} MD</h1>
			<h3 class="text-xl font-medium mb-10 opacity-90 uppercase tracking-widest">Professional {niche} Solutions for Maryland Neighbors</h3>
			<a href={`tel:${phone.replace(/-/g, '')}`} class="inline-block bg-white text-[#28657c] font-bold text-2xl px-12 py-4 border-2 border-white hover:bg-transparent hover:text-white transition-all uppercase tracking-tighter">
				Call For {page.name}: {phone}
			</a>
		</div>
	</section>

	<!-- 2. Main Content Stack (Mimicking Irving Side-by-Side) -->
	<section class="py-20 bg-white">
		<div class="container mx-auto px-6 grid md:grid-cols-3 gap-16 items-start">
			<div class="md:col-span-2">
				<h2 class="text-4xl font-bold text-[#28657c] mb-8 uppercase tracking-tighter">{page.name} Experts in {city}, MD</h2>
				<div class="prose prose-lg text-slate-600 space-y-8">
					<p class="text-xl leading-relaxed">{page.text}</p>
					
					<div class="my-12">
						<img src={page.image} alt={page.name} class="w-full h-[450px] object-cover rounded shadow-2xl border-4 border-white ring-1 ring-slate-200" />
					</div>

					<h3 class="text-2xl font-bold text-[#28657c] uppercase tracking-tighter">Why Choose Our {city} Team for {page.name}?</h3>
					<p>When you choose our locally owned team in {city}, Maryland, you are getting more than just a service—you are getting professional expertise backed by years of experience in the local community. We utilize industrial-grade equipment that out-performs anything available for rent, ensuring your {page.name} is handled safely and effectively.</p>
					
					<ul class="list-none space-y-4 font-bold text-slate-800">
						<li class="flex items-center gap-2"><span class="text-[#28657c] text-xl">✅</span> Fast Response Times in {city} & All of Howard County</li>
						<li class="flex items-center gap-2"><span class="text-[#28657c] text-xl">✅</span> Maryland Licensed & Insured Technicians</li>
						<li class="flex items-center gap-2"><span class="text-[#28657c] text-xl">✅</span> Modern Industrial Equipment for Complete Service</li>
						<li class="flex items-center gap-2"><span class="text-[#28657c] text-xl">✅</span> 100% Satisfaction Guaranteed Locally</li>
					</ul>

					<div class="bg-slate-50 p-8 rounded-lg border-l-8 border-[#28657c] mt-12">
						<p class="italic text-slate-700 font-medium">"We understand the specific environmental and soil needs of Maryland properties. Whether it's a routine visit or a major emergency, we treat your property with the respect it deserves."</p>
					</div>
				</div>
			</div>

			<!-- Irving Mimic Sidebar Form -->
			<div class="bg-slate-50 border-2 border-[#28657c] p-8 shadow-xl sticky top-8">
				<h3 class="text-xl font-bold text-center text-[#28657c] uppercase mb-8 tracking-tighter">Quick {page.name} Quote</h3>
				<form class="space-y-4">
					<input type="text" placeholder="Your Name" class="w-full border border-slate-300 p-3 outline-[#28657c]" />
					<input type="tel" placeholder="Phone Number" class="w-full border border-slate-300 p-3 outline-[#28657c]" />
					<textarea placeholder={`Tell us about your ${page.name} needs...`} class="w-full border border-slate-300 p-3 h-32 outline-[#28657c]"></textarea>
					<button class="w-full bg-[#28657c] text-white py-4 font-bold text-lg uppercase tracking-tighter hover:bg-[#1e4e5e] transition-colors shadow-lg">Submit Request</button>
				</form>
				<p class="text-[10px] text-slate-400 mt-4 text-center uppercase font-bold tracking-widest">Maryland's Trusted Pros</p>
			</div>
		</div>
	</section>

	<!-- Footer Keywords -->
	<section class="py-12 bg-slate-50 border-t border-slate-100">
		<div class="container mx-auto px-6 text-center text-xs text-slate-400 uppercase tracking-widest">
			Serving {city} Maryland and Surrounding Howard, Baltimore, and Anne Arundel Counties.
		</div>
	</section>
</Layout>
