  },
  "inspections": {
    name: "System Inspections",
    title: `Septic System Inspections ${city} MD | Real Estate Certifications`,
    image: "https://sc02.alicdn.com/kf/A1c0cdafca85f40479b7f34f61a5b75357.png",
    text: `Buying or selling a home in ${city}? Our certified Maryland septic inspectors provide comprehensive system audits required for real estate transfers. We check tank integrity, baffle condition, and drain field performance to give you a clear picture of the system's health before you sign on the dotted line.`
  },
  "grease-traps": {
    name: "Grease Trap Cleaning",
    title: `Commercial Grease Trap Cleaning ${city} MD | Restaurant Services`,
    image: "https://sc02.alicdn.com/kf/A51bdf3e42e8747b2bdd0fa8cee59f09db.png",
    text: `For ${city} restaurant owners, a clogged grease trap can shut down your business in an instant. We provide scheduled and emergency grease trap pumping to keep your commercial kitchen compliant and odor-free. Our team handles all documentation required by Maryland environmental health inspectors.`
  },
  // TREE
  "emergency-removal": {
    name: "Emergency Tree Removal",
    title: `24/7 Emergency Tree Removal ${city} MD | Storm Damage Care`,
    image: "https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=1200&q=80",
    text: `When a storm hits ${city}, trees don't wait for business hours. Our emergency response team is on standby 24/7 to handle fallen trees on houses, blocked driveways, and hazardous hanging limbs. We utilize specialized cranes and rigging equipment to safely remove massive debris without further damaging your property.`
  },
  "tree-trimming": {
    name: "Tree Trimming & Pruning",
    title: `Professional Tree Trimming ${city} MD | Arborist Care`,
    image: "https://sc02.alicdn.com/kf/Afe3aa9e81b0e495a85667f4139b9cf639.png",
    text: `Maintain the health and beauty of your ${city} landscape with professional tree trimming and pruning. Our licensed arborists identify dead wood, promote healthy growth, and ensure proper clearance from power lines and structures. Regular pruning prevents storm damage before it happens.`
  },
