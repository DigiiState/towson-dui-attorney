}

const { slug } = Astro.params;

const phone = "866-891-9778";
const city = "Phoenix";
const niche = "Septic Pumping";

// Expanded Content Database with Specific Images
const contentDb: Record<string, any> = {
  // SEPTIC
  "septic-pumping": {
