  },
  "storm-damage": {
    name: "Storm Damage Care",
    title: `Storm Damage Tree Cleanup ${city} MD | After-Storm Recovery`,
    image: "https://sc02.alicdn.com/kf/Aa06c0c3f7ae44f5ca0dc3bec04420a67Q.png",
    text: `After a major Maryland storm, your property in ${city} may be littered with dangerous branches and debris. We provide comprehensive after-storm cleanup, safely removing hanging "widow-makers" and ensuring your trees are structurally sound for the future.`
  },
  // WATER
  "water-extraction": {
    name: "Water Extraction",
    title: `Emergency Water Extraction ${city} MD | Flood Cleanup`,
    image: "https://sc02.alicdn.com/kf/A4fe71a4344644752848c5328899d28f41.png",
