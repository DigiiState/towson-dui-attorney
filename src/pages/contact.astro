---
import Layout from '../layouts/Layout.astro';

const phone = "866-891-9778";
const city = "Phoenix";
const niche = "Septic Pumping";
---

<Layout 
	title={`Contact Us | Emergency ${city} MD ${niche} Service`}
	phone={phone}
	city={city}
	niche={niche}
>
	<main class="max-w-4xl mx-auto px-6 py-20">
		<h1 class="text-4xl font-black mb-8 border-b-4 border-red-600 inline-block">Contact Us</h1>
		
		<div class="grid md:grid-cols-2 gap-12">
			<div>
				<h2 class="text-2xl font-bold mb-6">Need Help Right Now?</h2>
				<p class="text-lg mb-8">Call our emergency dispatch for the fastest response in {city}.</p>
				
				<a href={`tel:${phone.replace(/-/g, '')}`} class="block text-center bg-red-600 text-white py-4 text-3xl font-black rounded-lg shadow-xl hover:bg-red-700 transition-colors mb-12">
					📞 {phone}
				</a>

				<div class="space-y-4 text-slate-600">
					<p><strong>Service Area:</strong> {city}, Maryland and surrounding zip codes.</p>
					<p><strong>Hours:</strong> 24/7 Emergency Service</p>
				</div>
			</div>

			<div class="bg-slate-50 p-8 rounded-lg border border-slate-200">
				<h2 class="text-xl font-bold mb-6">Send a Message</h2>
				<form class="space-y-4">
					<div>
						<label class="block text-xs font-bold uppercase mb-1">Your Name</label>
						<input type="text" class="w-full border border-slate-300 p-3 rounded" placeholder="John Doe" />
					</div>
					<div>
						<label class="block text-xs font-bold uppercase mb-1">Phone Number</label>
						<input type="tel" class="w-full border border-slate-300 p-3 rounded" placeholder="(410) 555-0100" />
					</div>
					<div>
						<label class="block text-xs font-bold uppercase mb-1">Service Needed</label>
						<textarea class="w-full border border-slate-300 p-3 rounded h-32" placeholder="Tell us how we can help..."></textarea>
					</div>
					<button class="w-full bg-blue-600 text-white py-4 font-black uppercase tracking-widest rounded hover:bg-blue-700">Send Request</button>
				</form>
			</div>
		</div>
	</main>
</Layout>
